# ── Supabase (public + server) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# ── Discord webhook ──────────────────────────────────────────
DISCORD_WEBHOOK_SECRET=change-me-to-a-long-random-string-min-32-chars
DISCORD_GUILD_ID=your-guild-id
DISCORD_WORK_CHANNEL_ID=your-work-voice-channel-id

# ── App ──────────────────────────────────────────────────────
# IANA timezone used to compute attendance_date, e.g. Asia/Manila
APP_TIMEZONE=UTC
NEXT_PUBLIC_APP_TIMEZONE=UTC

# ── Bot (discord-attendance-bot/.env) ─────────────────────────
# Copy these into discord-attendance-bot/.env (see that package's README):
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_GUILD_ID=your-guild-id (same as above)
# DISCORD_WORK_CHANNEL_ID=your-work-voice-channel-id (same as above)
# ATTENDANCE_API_URL=https://your-app.vercel.app/api/discord/voice-event
# DISCORD_WEBHOOK_SECRET=same-secret-as-above-min-32-chars
